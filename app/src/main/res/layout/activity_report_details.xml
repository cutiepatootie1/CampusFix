<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_background"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/campus_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close button"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/campus_on_primary" />

        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Report"
            android:textColor="@color/campus_on_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ticket & Location Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/campus_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/campus_surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTicketId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/campus_primary_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Ticket ID"
                        android:textColor="@color/campus_on_primary_container"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category: | "
                            android:textColor="@color/campus_on_surface_variant"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBuildingRm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Building:"
                            android:textColor="@color/campus_on_surface"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Photo & Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/campus_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/campus_surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="185dp"
                        android:background="@color/campus_surface_variant"
                        android:contentDescription="Issue photo"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:letterSpacing="0.04"
                        android:text="DESCRIPTION"
                        android:textColor="@color/campus_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text=""
                        android:textColor="@color/campus_on_surface"
                        android:textSize="15sp"
                        tools:text="Leaking pipe near the second-floor sink in the science building." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Timeline Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/campus_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/campus_surface_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress Timeline"
                        android:textColor="@color/campus_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Step 1: Reported -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="60dp">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.42" />

                        <View
                            android:id="@+id/dotReported"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/timeline_dot"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:id="@+id/lineReported"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="@color/campus_secondary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/dotReported"
                            app:layout_constraintStart_toStartOf="@id/dotReported"
                            app:layout_constraintTop_toBottomOf="@id/dotReported" />

                        <TextView
                            android:id="@+id/tvReportedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Reported"
                            android:textColor="@color/campus_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/dotReported"
                            app:layout_constraintStart_toEndOf="@id/dotReported"
                            app:layout_constraintTop_toTopOf="@id/dotReported" />

                        <TextView
                            android:id="@+id/tvReportedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Oct. 22, 2026 - 10:36 AM"
                            android:textColor="@color/campus_on_surface_variant"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotReported"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/dotReported" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Step 2: Acknowledged -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/stepAcknowledged"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.42" />

                        <View
                            android:id="@+id/dotAcknowledged"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/timeline_dot"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:id="@+id/lineAcknowledged"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="@color/campus_accent_amber"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/dotAcknowledged"
                            app:layout_constraintStart_toStartOf="@id/dotAcknowledged"
                            app:layout_constraintTop_toBottomOf="@id/dotAcknowledged" />

                        <TextView
                            android:id="@+id/tvAcknowledgedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Acknowledged"
                            android:textColor="@color/campus_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/dotAcknowledged"
                            app:layout_constraintStart_toEndOf="@id/dotAcknowledged"
                            app:layout_constraintTop_toTopOf="@id/dotAcknowledged" />

                        <TextView
                            android:id="@+id/tvAcknowledgedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/campus_on_surface_variant"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotAcknowledged"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline2"
                            app:layout_constraintTop_toTopOf="@id/dotAcknowledged" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Step 3: Resolved -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/stepResolved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.42" />

                        <View
                            android:id="@+id/dotResolved"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/timeline_dot"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvResolvedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Resolved"
                            android:textColor="@color/campus_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/dotResolved"
                            app:layout_constraintStart_toEndOf="@id/dotResolved"
                            app:layout_constraintTop_toTopOf="@id/dotResolved" />

                        <TextView
                            android:id="@+id/tvResolvedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/campus_on_surface_variant"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotResolved"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline3"
                            app:layout_constraintTop_toTopOf="@id/dotResolved" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>