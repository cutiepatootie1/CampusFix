<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="vertical">
    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/material_dynamic_secondary80"
        android:orientation="horizontal"
        android:gravity="left"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        >
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Close button"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            />
        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Report"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        android:layout_gravity="fill_vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/tvTicketId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ticket ID"
                android:textSize="18sp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvCategory"
                    android:text="Category: | "
                    android:textSize="18sp"
                    />
                <TextView
                    android:id="@+id/tvBuildingRm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Building:"
                    android:textSize="18sp"/>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:id="@+id/ivPhoto"
                android:layout_marginVertical="5dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text=""/>

            <com.google.android.material.card.MaterialCardView
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/darker_gray"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress Timeline"
                        android:textColor="@android:color/black"
                        android:textSize="18sp" />

                    <!-- Step 1: Reported (has connector line below the dot) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="64dp">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.42" />

                        <View
                            android:id="@+id/dotReported"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/timeline_dot"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:id="@+id/lineReported"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="#555555"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/dotReported"
                            app:layout_constraintStart_toStartOf="@id/dotReported"
                            app:layout_constraintTop_toBottomOf="@id/dotReported" />

                        <TextView
                            android:id="@+id/tvReportedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Reported"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotReported"
                            app:layout_constraintStart_toEndOf="@id/dotReported"
                            app:layout_constraintTop_toTopOf="@id/dotReported" />

                        <TextView
                            android:id="@+id/tvReportedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Oct. 22, 2026 - 10:36 AM"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotReported"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/dotReported" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Step 2: Acknowledged -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/stepAcknowledged"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.42" />

                        <View
                            android:id="@+id/dotAcknowledged"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/timeline_dot"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:id="@+id/lineAcknowledged"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="#555555"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/dotAcknowledged"
                            app:layout_constraintStart_toStartOf="@id/dotAcknowledged"
                            app:layout_constraintTop_toBottomOf="@id/dotAcknowledged" />

                        <TextView
                            android:id="@+id/tvAcknowledgedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Acknowledged"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotAcknowledged"
                            app:layout_constraintStart_toEndOf="@id/dotAcknowledged"
                            app:layout_constraintTop_toTopOf="@id/dotAcknowledged" />

                        <TextView
                            android:id="@+id/tvAcknowledgedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotAcknowledged"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline2"
                            app:layout_constraintTop_toTopOf="@id/dotAcknowledged" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Step 3: Resolved (last step, no connector line) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/stepResolved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.42" />

                        <View
                            android:id="@+id/dotResolved"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/timeline_dot"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvResolvedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Resolved"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotResolved"
                            app:layout_constraintStart_toEndOf="@id/dotResolved"
                            app:layout_constraintTop_toTopOf="@id/dotResolved" />

                        <TextView
                            android:id="@+id/tvResolvedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/dotResolved"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline3"
                            app:layout_constraintTop_toTopOf="@id/dotResolved" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>